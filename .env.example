# Paper/Minecraft version to run. This plugin is compiled for Paper 26.3 alpha.
MC_VERSION=26.3

# Minecraft Custom Utilities version embedded in plugin.yml and the JAR manifest.
APP_VERSION=1.3.9

# Host port exposed for Minecraft clients.
MC_PORT=25565

# JVM heap size used by itzg/minecraft-server.
MC_MEMORY=2G

# Change this before exposing RCON beyond your local machine.
RCON_PASSWORD=minecraft-custom-utilities
